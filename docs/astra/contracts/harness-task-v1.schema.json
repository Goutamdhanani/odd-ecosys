{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odd-ecosys:astra:harness-task-v1",
  "title": "Astra HarnessTask and HarnessResult v1 (design draft)",
  "description": "Contract shape only. S00 design artifact; not a runtime or completed X01/X02 implementation.",
  "oneOf": [
    { "$ref": "#/$defs/HarnessTask" },
    { "$ref": "#/$defs/HarnessResult" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "TenantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/Identifier" }
      }
    },
    "TenantRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "recordId"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/Identifier" },
        "recordId": { "$ref": "#/$defs/Identifier" }
      }
    },
    "VersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "version": { "$ref": "#/$defs/Identifier" },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ModelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoningEffort"],
      "properties": {
        "provider": { "const": "glm-5.3-api" },
        "model": { "const": "GLM-5.3" },
        "reasoningEffort": { "enum": ["low", "high", "max"] }
      }
    },
    "EgressMode": {
      "enum": ["MINIMIZED_REMOTE", "APPROVED_REMOTE", "NO_MODEL_EGRESS"]
    },
    "ContextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordRef", "recordType", "revision", "sha256", "sensitivity", "egressMode"],
      "properties": {
        "recordRef": { "$ref": "#/$defs/TenantRecordRef" },
        "recordType": {
          "enum": ["account", "contact", "offer", "evidence", "claim", "policy", "approval", "skill"]
        },
        "revision": { "$ref": "#/$defs/Identifier" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "sensitivity": {
          "enum": ["public_business", "tenant_confidential", "personal_data", "restricted"]
        },
        "egressMode": { "$ref": "#/$defs/EgressMode" }
      }
    },
    "ContextManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "tenantRef", "createdAt", "entries", "sha256"],
      "properties": {
        "manifestVersion": { "const": 1 },
        "tenantRef": { "$ref": "#/$defs/TenantRef" },
        "createdAt": { "type": "string", "format": "date-time" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContextEntry" },
          "maxItems": 256
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxModelCalls", "maxReadToolCalls", "maxSpendMicroUsd", "deadlineSeconds", "maxRepairAttempts", "maxChallengeRounds"],
      "properties": {
        "maxModelCalls": { "type": "integer", "minimum": 0, "maximum": 4 },
        "maxReadToolCalls": { "type": "integer", "minimum": 0, "maximum": 6 },
        "maxSpendMicroUsd": { "type": "integer", "minimum": 0 },
        "deadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxRepairAttempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "maxChallengeRounds": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "AllowedReadTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argumentSchemaRef", "capability"],
      "properties": {
        "name": { "$ref": "#/$defs/Identifier" },
        "argumentSchemaRef": { "$ref": "#/$defs/VersionRef" },
        "capability": { "const": "read" }
      }
    },
    "RequiredOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "minimumCount"],
      "properties": {
        "artifactType": {
          "enum": ["research_report", "evidence_summary", "claim_set", "verification_result", "draft_copy", "reply_classification"]
        },
        "minimumCount": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "RubricCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "kind", "required"],
      "properties": {
        "checkId": { "$ref": "#/$defs/Identifier" },
        "kind": {
          "enum": ["tenant_ownership", "required_output_present", "schema_valid", "evidence_refs_resolve", "freshness", "contradictions", "permission_boundary"]
        },
        "required": { "const": true }
      }
    },
    "CompletionRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionRef", "checks"],
      "properties": {
        "versionRef": { "$ref": "#/$defs/VersionRef" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/RubricCheck" }
        }
      }
    },
    "ProgressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionRef", "progressSignals", "noProgressAction"],
      "properties": {
        "versionRef": { "$ref": "#/$defs/VersionRef" },
        "progressSignals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["new_usable_evidence", "contradiction_resolved", "required_output_satisfied"]
          }
        },
        "noProgressAction": { "enum": ["stop_for_review", "abstain"] }
      }
    },
    "VersionPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt", "skills"],
      "properties": {
        "model": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ModelRef" }
          ]
        },
        "prompt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/VersionRef" }
          ]
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/VersionRef" },
          "maxItems": 32
        }
      }
    },
    "TaskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantRef", "taskId", "revision"],
      "properties": {
        "tenantRef": { "$ref": "#/$defs/TenantRef" },
        "taskId": { "$ref": "#/$defs/Identifier" },
        "revision": { "$ref": "#/$defs/Identifier" }
      }
    },
    "HarnessTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractKind", "schemaVersion", "task", "runRef", "subjectRefs", "purpose", "taskRevision",
        "policyRefs", "inputEvidenceRefs", "contextManifest", "allowedReadTools", "requiredOutputs",
        "versionPins", "limits", "retryPolicy", "progressPolicy", "completionRubric", "egressMode"
      ],
      "properties": {
        "contractKind": { "const": "HarnessTask" },
        "schemaVersion": { "const": "1.0.0" },
        "task": { "$ref": "#/$defs/TaskIdentity" },
        "runRef": { "$ref": "#/$defs/TenantRecordRef" },
        "subjectRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/TenantRecordRef" }
        },
        "purpose": { "enum": ["research", "verification", "drafting", "reply_classification"] },
        "taskRevision": { "$ref": "#/$defs/VersionRef" },
        "policyRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/VersionRef" }
        },
        "inputEvidenceRefs": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/TenantRecordRef" }
        },
        "contextManifest": { "$ref": "#/$defs/ContextManifest" },
        "allowedReadTools": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AllowedReadTool" }
        },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/RequiredOutput" }
        },
        "versionPins": { "$ref": "#/$defs/VersionPins" },
        "limits": { "$ref": "#/$defs/Limits" },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "versionRef", "modelTimeout", "externalSideEffects"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "versionRef": { "$ref": "#/$defs/VersionRef" },
            "modelTimeout": { "enum": ["reconcile_usage_then_bounded_retry", "stop_for_review"] },
            "externalSideEffects": { "const": "prohibited" }
          }
        },
        "progressPolicy": { "$ref": "#/$defs/ProgressPolicy" },
        "completionRubric": { "$ref": "#/$defs/CompletionRubric" },
        "egressMode": { "$ref": "#/$defs/EgressMode" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "recordRef", "sha256"],
      "properties": {
        "artifactType": {
          "enum": ["research_report", "evidence_summary", "claim_set", "verification_result", "draft_copy", "reply_classification"]
        },
        "recordRef": { "$ref": "#/$defs/TenantRecordRef" },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "UnresolvedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "evidenceRefs"],
      "properties": {
        "reasonCode": {
          "enum": ["missing_evidence", "stale_evidence", "identity_ambiguous", "contradiction", "policy_block", "budget_exhausted", "external_usage_unknown", "other"]
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/TenantRecordRef" },
          "maxItems": 128
        }
      }
    },
    "CompletionCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "outcome", "reasonCode"],
      "properties": {
        "checkId": { "$ref": "#/$defs/Identifier" },
        "outcome": { "enum": ["passed", "failed", "not_applicable"] },
        "reasonCode": { "$ref": "#/$defs/Identifier" }
      }
    },
    "AttemptUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "provider", "billingStatus", "inputTokens", "outputTokens", "costMicroUsd"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/Identifier" },
        "provider": { "const": "glm-5.3-api" },
        "billingStatus": { "enum": ["measured", "unknown"] },
        "inputTokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "outputTokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "costMicroUsd": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "providerRequestIdHash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "HarnessResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractKind", "schemaVersion", "task", "status", "artifacts", "claimRefs", "unresolvedQuestions",
        "completionChecks", "proposedNextStep", "evidenceLinkedSummary", "usage", "checkpointRef", "completedAt"
      ],
      "properties": {
        "contractKind": { "const": "HarnessResult" },
        "schemaVersion": { "const": "1.0.0" },
        "task": { "$ref": "#/$defs/TaskIdentity" },
        "status": { "enum": ["completed", "abstained", "review_required", "cancelled", "failed"] },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRef" },
          "maxItems": 128
        },
        "claimRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/TenantRecordRef" },
          "maxItems": 1000
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": { "$ref": "#/$defs/UnresolvedQuestion" },
          "maxItems": 128
        },
        "completionChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/CompletionCheckResult" },
          "maxItems": 32
        },
        "proposedNextStep": { "enum": ["none", "research_more", "human_review", "abstain"] },
        "evidenceLinkedSummary": { "type": "string", "maxLength": 1000 },
        "usage": {
          "type": "array",
          "items": { "$ref": "#/$defs/AttemptUsage" },
          "maxItems": 4
        },
        "checkpointRef": { "$ref": "#/$defs/VersionRef" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
