# Copy only into a dedicated, isolated sandbox after its scope is explicitly approved.
# Node does not load this file automatically. The local preview runner scrubs process environment.
# Saving values here does not authorize running the app, workers, provider calls, or live actions.

# Preview and outbound gates: keep enabled/closed for local synthetic work.
LOCAL_PREVIEW=1
ASTRA_LOCAL_PREVIEW=true
ASTRA_PREVIEW=true
ASTRA_TENANT_MODE=1
ASTRA_GLM_LOCAL_PREVIEW=true
ASTRA_GLM_EGRESS_ENABLED=false
ASTRA_EXTERNAL_ACTIONS_ENABLED=false
ASTRA_LIVE_ACTIONS=disabled
ASTRA_GLOBAL_PROVIDER_DECISION=denied
ASTRA_GLOBAL_PROVIDER_DECISION_EXPIRES_AT=
ASTRA_LAUNCH_ACTIVATION_AUTHORIZED=disabled
ASTRA_LAUNCH_LIVE_DISPATCH_AUTHORIZED=disabled
ASTRA_S01_COMMERCIAL_PRIVACY_AUTHORIZED=disabled
ASTRA_OPTIMIZER_EGRESS_AUTHORIZED=disabled
ASTRA_SOURCE_COLLECTION_REMOTE_ENABLED=false

# Local app identity/auth; replace private values only in the protected sandbox copy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ODD_DB_PATH=./data/astra-sandbox.sqlite
ODD_AUTH_BOOTSTRAP_TOKEN=
ODD_AUTH_RECOVERY_TOKEN=
ODD_CREDENTIAL_ENCRYPTION_KEY=
ODD_CREDENTIAL_ENFORCE_ENCRYPTION=true

# Astra tenant store: use disposable sandbox databases only, with distinct app/worker roles.
ASTRA_DATABASE_URL=
ASTRA_WORKER_DATABASE_URL=
ASTRA_CONTEXT_SECRET=

# Fixed in source to provider glm-5.3-api / model GLM-5.3; there is no model-selection env var.
# Keep empty unless a later separately approved isolated test explicitly needs a key.
ASTRA_GLM_API_KEY=

# Source collection: SearXNG origin is server-owned; remote transport remains disabled above.
ASTRA_SOURCE_COLLECTION_SEARXNG_ORIGIN=
ASTRA_SOURCE_COLLECTION_APPROVALS_JSON=

# Implemented optional integrations. Leave blank; neither is needed for local preview.
REACHER_API_URL=
REACHER_API_SECRET=
REACHER_TIMEOUT_MS=8000
ODD_DISIFY_DOMAIN_CHECK=0
TWENTY_API_URL=
TWENTY_API_TOKEN=

# SMTP/IMAP mailbox passwords are saved through the existing encrypted mailbox setup
# using ODD_CREDENTIAL_ENCRYPTION_KEY; there are no mailbox-password environment variables.
# Other provider adapters without a verified implementation contract are not configured here.
# Guided goals: disabled until operator review; customer text never grants source rights.
ASTRA_GOAL_PLANNER_AUTHORIZED=disabled
ASTRA_GOAL_PLANNER_LIVE_AUTHORIZED=disabled
# Strict registry v1 scoped to tenant + industry + country + city; see integration template.
ASTRA_GOAL_SOURCE_RIGHTS_JSON=
